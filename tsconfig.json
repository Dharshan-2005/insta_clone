{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "frontend", "services", "packages"]
}
